{
  "$schema": "https://opencode.ai/config.json",

  "model": "ollama/qwen3:1.7b",

  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Local",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen3:1.7b": {
          "name": "Qwen3 1.7B Local"
        }
      }
    }
  },

  "permission": {
    "*": "ask",

    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },

    "edit": {
      "*": "deny",
      "src/xyra_logic/*": "allow",
      "tests/*": "allow",
      "scripts/*": "allow"
    },

    "bash": {
      "*": "ask",

      "pwd": "allow",
      "ls *": "allow",
      "find *": "allow",
      "grep *": "allow",

      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git rev-parse *": "allow",

      "python3 -m unittest *": "allow",
      "python3 scripts/*": "allow",

      "git add *": "deny",
      "git commit *": "deny",
      "git push *": "deny",
      "git merge *": "deny",
      "git rebase *": "deny",
      "git reset *": "deny",
      "git switch *": "deny",
      "git checkout *": "deny",
      "git clean *": "deny",
      "git restore *": "deny",

      "curl *": "deny",
      "wget *": "deny",
      "sudo *": "deny",
      "apt *": "deny",
      "apt-get *": "deny",
      "pip *": "deny",
      "pip3 *": "deny",
      "ollama pull *": "deny"
    },

    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "task": "deny"
  }
}
